# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Database
DB_USER=neuroroute
DB_PASSWORD=neuroroute
DB_NAME=neuro_route
DATABASE_URL=postgresql://neuroroute:neuroroute@localhost:5432/neuro_route
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Simulation
SIMULATION_SEED=42
SIMULATION_TICK_INTERVAL_SEC=1.0
SIMULATION_DEFAULT_SPEED=1
SIMULATION_MAX_VEHICLES_VISIBLE=200

# ML
MODEL_DIR=/app/models
ACTIVE_MODEL_VERSION=latest
PREDICTION_HORIZONS=5,15,30,60
MODEL_INFERENCE_BATCH_SIZE=100

# Routing
ROUTING_WEIGHTS_TRAVEL_TIME=1.0
ROUTING_WEIGHTS_CONGESTION=0.5
ROUTING_WEIGHTS_INCIDENT=1.0
ROUTING_WEIGHTS_RISK=0.3
REROUTE_THRESHOLD_SEC=120

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_MESSAGE_SIZE=1048576
WS_UPDATE_THROTTLE_MS=500

# LLM & NVIDIA NIM (for AI traffic explanations)
LLM_PROVIDER=nvidia_nim
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_TIMEOUT=15.0
LLM_LOCAL_URL=http://localhost:11434
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_TIMEOUT_SEC=15

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json